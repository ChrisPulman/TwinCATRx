<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net48;net481;net8.0;net9.0;net10.0;net8.0-windows10.0.19041.0;net9.0-windows10.0.19041.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CP.TwinCATRx</PackageId>
    <Title>TwinCATRx</Title>
    <RootNamespace>CP.TwinCatRx</RootNamespace>
  </PropertyGroup>
  
  <PropertyGroup Condition="!$([System.String]::new('$(TargetFramework)').StartsWith('net4'))">
    <!-- Allow consumers to trim unused APIs from this library -->
    <IsTrimmable>true</IsTrimmable>
    <!-- Enable AOT compatibility analysis on modern TFMs -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <DefineConstants>$(DefineConstants);HASHTABLERX_STRUCTURE_API</DefineConstants>
  </PropertyGroup>

  <!-- Define WINDOWS symbol for Windows-targeted TFMs -->
  <PropertyGroup Condition="$([System.String]::new('$(TargetFramework)').StartsWith('net4')) or '$(TargetFramework)' == 'net8.0-windows10.0.19041.0' or '$(TargetFramework)' == 'net9.0-windows10.0.19041.0' or '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="$([System.String]::new('$(TargetFramework)').StartsWith('net4'))">
    <PackageReference Include="Polyfill" Version="10.11.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HashTableRx" Version="3.0.1" />
    <PackageReference Include="ReactiveUI.Primitives" Version="6.0.0" />
    <PackageReference Include="ReactiveUI.Primitives.Async" Version="6.0.0" />
    <PackageReference Include="ReactiveUI.Primitives.Extensions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwinCATRx.Core\TwinCATRx.Core.csproj" />
    <ProjectReference Include="..\TwinCATRx.SourceGenerators\TwinCATRx.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Async" />
    <Using Include="ReactiveUI.Primitives.Extensions" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Disposables.MultipleDisposable" Alias="CompositeDisposable" />
    <Using Include="ReactiveUI.Primitives.Signals.Signal" Alias="Observable" />
    <Using Include="ReactiveUI.Primitives.RxVoid" Alias="Unit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\TwinCATRx.SourceGenerators\bin\Debug\netstandard2.0\TwinCATRx.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"
          Condition="'$(Configuration)' == 'Debug' and Exists('$(MSBuildThisFileDirectory)..\TwinCATRx.SourceGenerators\bin\Debug\netstandard2.0\TwinCATRx.SourceGenerators.dll')" />
    <None Include="$(MSBuildThisFileDirectory)..\TwinCATRx.SourceGenerators\bin\Release\netstandard2.0\TwinCATRx.SourceGenerators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"
          Condition="'$(Configuration)' == 'Release' and Exists('$(MSBuildThisFileDirectory)..\TwinCATRx.SourceGenerators\bin\Release\netstandard2.0\TwinCATRx.SourceGenerators.dll')" />
  </ItemGroup>

</Project>
